FROM bde2020/hadoop-nodemanager:2.0.0-hadoop3.2.1-java8

# The YARN NodeManager is where mapper.py/reducer.py actually execute
# (shipped there via Hadoop Streaming's -files distributed cache), so it
# needs a python3 interpreter even though the base Hadoop image doesn't
# ship one.
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*
